{
  "schemaVersion": "0.1.0",
  "name": "研究资料收集",
  "behavior": "create",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "00-收件箱/已下载",
  "context": "{{content}}",
  "properties": [
    {
      "name": "type",
      "value": "source",
      "type": "text"
    },
    {
      "name": "status",
      "value": "inbox",
      "type": "text"
    },
    {
      "name": "source_url",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "source_title",
      "value": "{{title}}",
      "type": "text"
    },
    {
      "name": "source_author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "source_published",
      "value": "{{published}}",
      "type": "text"
    },
    {
      "name": "captured_at",
      "value": "{{date}}",
      "type": "date"
    },
    {
      "name": "tags",
      "value": "inbox/downloaded",
      "type": "multitext"
    }
  ],
  "triggers": [
    "schema:@Article"
  ],
  "noteContentFormat": "# {{title}}\n\n> [!source]\n> **Source:** {{url}}  \n> **Author:** {{author}}  \n> **Published:** {{published}}  \n> **Captured:** {{date}}\n\n## Original content\n\n{{content}}\n"
}
